generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum Role {
  ADMIN
  PARTNER
  STUDENT
}

enum ShopStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  name         String
  studentId    String?
  role         Role       @default(STUDENT)
  createdAt    DateTime   @default(now())
  shops        Shop[]
  favorites    Favorite[]
  reviews      Review[]
}

model Shop {
  id        Int        @id @default(autoincrement())
  ownerId   Int
  owner     User       @relation(fields: [ownerId], references: [id])
  name      String
  zone      String
  address   String?
  openTime  String     @default("09:00")
  closeTime String     @default("21:00")
  lat       Float
  lng       Float
  status    ShopStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  menus     MenuItem[]
  favorites Favorite[]
  reviews   Review[]

  @@index([ownerId])
  @@index([status])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId    Int
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, shopId])
  @@index([shopId])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId    Int
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rating    Int
  content   String   @db.VarChar(1200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, shopId])
  @@index([shopId, createdAt])
}

model MenuItem {
  id           Int     @id @default(autoincrement())
  shopId       Int
  shop         Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Int
  specialPrice Int?

  @@index([shopId])
}

model SpinLog {
  id        Int      @id @default(autoincrement())
  budget    Int
  shopName  String
  menuName  String
  source    String
  createdAt DateTime @default(now())
}
